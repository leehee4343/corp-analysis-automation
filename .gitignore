# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 런타임 데이터 (실행 결과물, 버전관리 대상 아님)
data/*
!data/.gitkeep
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# 실제 원본 PDF (용량 크고 민감한 사업자 정보 — git 추적 금지)
/PDF/
tests/sample_pdfs/*.pdf

# Tesseract 언어 데이터 (용량 커서 git 추적 안 함 — setup_tessdata.py로 재생성 가능)
/.tessdata/

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
